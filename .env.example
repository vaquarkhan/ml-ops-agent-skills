# MLflow & Databricks Unity Catalog
MLFLOW_TRACKING_URI=http://localhost:5000
DATABRICKS_UC_REGISTRY_URI=databricks-uc
UC_MODEL_NAME=main.mlops.user_classifier

# Feast feature store
FEAST_REPO_PATH=feature_store/feature_repo
REDIS_HOST=localhost
REDIS_PORT=6379

# Monitoring thresholds
PSI_DRIFT_THRESHOLD=0.2

# Governance gates
FAIRNESS_DP_THRESHOLD=0.05

# Serving
INFERENCE_ENDPOINT=http://localhost:8080/v1/completions
P95_LATENCY_THRESHOLD_MS=5000
